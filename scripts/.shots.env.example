# Copy to scripts/.shots.env (gitignored) and fill in. Used by `npm run shots`
# to log into the app and screenshot each page. This is your APP login (Supabase
# email/password) — NOT the database password.

SHOTS_EMAIL=you@example.com
SHOTS_PASSWORD=your-app-password

# Optional — defaults to the local dev server:
# SHOTS_BASE_URL=http://localhost:5173
