# Copy this file to scripts/.backup.env and fill in your real connection string.
# scripts/.backup.env is gitignored — never commit the password.
#
# Get the value from: Supabase dashboard → Project Settings → Database →
# Connection string → URI. Prefer the "Session pooler" URI (IPv4-friendly), and
# make sure it includes your database password (not the anon key).

SUPABASE_DB_URL="postgresql://postgres.tsxtwwdpekkciyjyumcr:[YOUR-DB-PASSWORD]@aws-0-eu-central-1.pooler.supabase.com:5432/postgres"

